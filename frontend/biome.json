{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": { "includes": ["src/**", "*.ts", "*.json"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 96 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "correctness": { "noUnusedVariables": "error", "noUnusedImports": "error" },
      "style": { "useConst": "error", "noNonNullAssertion": "warn" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
